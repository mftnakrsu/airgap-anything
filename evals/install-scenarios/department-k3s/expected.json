{
  "orchestration": "k3s",
  "phase_a": {
    "files": [
      "docs/airgap/install/plan.md"
    ],
    "only_files": [
      "docs/airgap/install/plan.md"
    ],
    "stops_after_plan": true,
    "asks_plan_approval": true
  },
  "phase_b": {
    "files": [
      "docs/airgap/install/INSTALL.md",
      "docs/airgap/install/kubernetes/",
      "docs/airgap/install/kubernetes/cluster/registries.yaml",
      "docs/airgap/install/compose/"
    ],
    "must_not_files": [
      "docs/airgap/install/AGENTS-INSTALL.md",
      "docs/airgap/install/INSIDE.md"
    ],
    "must_mention": [
      "INSTALL_K3S_SKIP_DOWNLOAD=true",
      "registries.yaml",
      "imagePullPolicy",
      "Ready",
      "harbor.yml"
    ],
    "must_not": [
      "an image tag latest",
      "a secret value in a file",
      "a GPU count other than blueprint §5",
      "a program or script file written into the project (.sh, .py, a render helper)"
    ],
    "manifest_marker": {
      "marker": "(from airgap-install)",
      "required_rows": [
        "docs/airgap/install/"
      ]
    }
  }
}
