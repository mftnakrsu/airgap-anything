{
  "orchestration": "docker-compose",
  "phase_a": {
    "files": [
      "docs/airgap/install/plan.md"
    ],
    "only_files": [
      "docs/airgap/install/plan.md"
    ],
    "stops_after_plan": true,
    "asks_plan_approval": true
  },
  "phase_b": {
    "must_not_files": [
      "docs/airgap/install/AGENTS-INSTALL.md",
      "docs/airgap/install/INSIDE.md"
    ],
    "must_mention": [
      "unverified",
      "ticket-search",
      "docling",
      "arm64",
      "docs/airgap/agents.md"
    ],
    "must_not": [
      "an image tag latest",
      "a secret value in a file",
      "a GPU count other than blueprint §5",
      "a service without pull_policy: never",
      "Qwen Code deployed as a service",
      "an Elasticsearch setting presented as sourced",
      "a health check for ticket-search presented as sourced",
      "a program or script file written into the project (.sh, .py, a render helper)"
    ],
    "manifest_marker": {
      "marker": "(from airgap-install)",
      "required_rows": [
        "docs/airgap/install/"
      ]
    }
  }
}
